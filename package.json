{
  "name": "resource-override",
  "version": "1.3.2",
  "description": "Chrome extension to override website resources - Manifest V3",
  "main": "manifest.json",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "zip": "cd dist && zip -r ../extension.zip ."
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.21",
    "@types/chrome": "^0.0.270",
    "@types/node": "^24.1.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.0",
    "antd": "^5.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "resource-override",
    "web-development",
    "debugging",
    "modular",
    "sourcemap",
    "vite",
    "rollup"
  ],
  "author": "Original: Kyle Paulsen, Updated for MV3 & Modular by AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ResourceOverride.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/ResourceOverride/issues"
  },
  "homepage": "https://github.com/your-username/ResourceOverride#readme",
  "engines": {
    "node": ">=16.0.0"
  }
}
